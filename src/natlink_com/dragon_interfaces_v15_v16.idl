// IDgnSRAudioFileSourceA
// Source: dspeech.h
// -------------------------------------------------------------------

[
    object,
    uuid(dd108008-6205-11cf-ae61-0000e8a28647),
    pointer_default(unique)
]
interface IDgnSRAudioFileSourceA : IUnknown
{
    HRESULT FileNameSet(
        [in] DWORD p0,
        [in, string] const char* p1
    );

    HRESULT EnableSet(
        [in] BOOL p0
    );

    // PlayListSet exists in dspeech.h but Dragon's dd10midl.dll omits it
    // from the proxy/stub for both A and W variants.  Excluded here to
    // match Dragon's actual wire format (3 user methods, not 4).

    HRESULT FileClose();

};

