    );

    HRESULT TopicDeserialize(
        [in] IUnknown* p0
    );

    HRESULT Activate(
        [in] BOOL p0
    );

    HRESULT Deactivate();

    // DNS 16 addition (not in SDK headers).
    // Dragon marshals the second param as a VARIANT via VARIANT_UserMarshal
    // (confirmed by NDR type format decode of dd10midl.dll), but changing
    // this to VARIANT in the IDL alters the TLB vtable layout for the
    // entire interface, breaking other methods.  Since Reserved15 is never
    // called, keep the original struct type for TLB stability.
    HRESULT Reserved15(
        [in] DWORD p0,
        [in] VDCTBOOKMARK p1
    );

};

