    );

    HRESULT TopicEnum(
        [in, out, unique] VDCTTOPICW** p0,
        [in, out, unique] DWORD* p1
    );

    // RE verification: dd10midl's NDR summary reports a 66-byte struct
    // here on DNS 15/16, matching LANGUAGEA rather than LANGUAGEW.
    HRESULT TopicAddString(
        [in, string] const WCHAR* p0,
        [in] LANGUAGEA* p1,
        [in] const WCHAR** p2
    );

