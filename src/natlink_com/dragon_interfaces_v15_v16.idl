//
// dragon_interfaces_v15_v16.idl
// Dragon NaturallySpeaking COM interfaces for cross-bitness marshaling.
// Covers DPI 15-16 (includes dwNotify on PlayString/PlayEvents for DNS 16+).
//
// Built via CMake (see CMakeLists.txt).
//

import "oaidl.idl";
import "ocidl.idl";

// ===================================================================
// Type definitions
// ===================================================================

typedef unsigned __int64 QWORD;
typedef QWORD* PQWORD;

typedef struct {
    [ptr, size_is(dwSize)] BYTE* pData;
    DWORD dwSize;
} SDATA;

typedef enum {
    VPS_UNKNOWN = 0,
    VPS_NOUN = 1,
    VPS_VERB = 2,
    VPS_ADVERB = 3,
    VPS_ADJECTIVE = 4,
    VPS_PROPERNOUN = 5,
    VPS_PRONOUN = 6,
    VPS_CONJUNCTION = 7,
    VPS_CARDINAL = 8,
    VPS_ORDINAL = 9,
    VPS_DETERMINER = 10,
    VPS_QUANTIFIER = 11,
    VPS_PUNCTUATION = 12,
    VPS_CONTRACTION = 13,
    VPS_INTERJECTION = 14,
    VPS_ABBREVIATION = 15,
    VPS_PREPOSITION = 16
} VOICEPARTOFSPEECH;

typedef [v1_enum] enum {
    SRGRMFMT_CFG = 0x0000,
    SRGRMFMT_LIMITEDDOMAIN = 0x0001,
    SRGRMFMT_DICTATION = 0x0002,
    SRGRMFMT_CFGNATIVE = 0x8000,
    SRGRMFMT_LIMITEDDOMAINNATIVE = 0x8001,
    SRGRMFMT_DICTATIONNATIVE = 0x8002,
    SRGRMFMT_DRAGONNATIVE1 = 0x8101,
    SRGRMFMT_DRAGONNATIVE2 = 0x8102,
    SRGRMFMT_DRAGONNATIVE3 = 0x8103
} SRGRMFMT;

typedef struct {
    LANGID LanguageID;
    CHAR szDialect[64];
} LANGUAGEA;

typedef struct {
    LANGID LanguageID;
    WCHAR szDialect[64];
} LANGUAGEW;

typedef struct {
    GUID gEngineID;
    CHAR szMfgName[262];
    CHAR szProductName[262];
    GUID gModeID;
    CHAR szModeName[262];
    LANGUAGEA language;
    DWORD dwSequencing;
    DWORD dwMaxWordsVocab;
    DWORD dwMaxWordsState;
    DWORD dwGrammars;
    DWORD dwFeatures;
    DWORD dwInterfaces;
    DWORD dwEngineFeatures;
} SRMODEINFOA;

typedef struct {
    GUID gEngineID;
    WCHAR szMfgName[262];
    WCHAR szProductName[262];
    GUID gModeID;
    WCHAR szModeName[262];
    LANGUAGEW language;
    DWORD dwSequencing;
    DWORD dwMaxWordsVocab;
    DWORD dwMaxWordsState;
    DWORD dwGrammars;
    DWORD dwFeatures;
    DWORD dwInterfaces;
    DWORD dwEngineFeatures;
} SRMODEINFOW;

typedef struct {
    DWORD dwSize;
    DWORD dwWordNum;
    CHAR szWord[1];  // variable-length
} SRWORDA;

typedef struct {
    DWORD dwSize;
    DWORD dwWordNum;
    WCHAR szWord[1];  // variable-length
} SRWORDW;

typedef struct {
    DWORD dwSize;
    [size_is(dwSize - 4)] BYTE abWords[];
} SRPHRASEA;

typedef struct {
    DWORD dwSize;
    [size_is(dwSize - 4)] BYTE abWords[];
} SRPHRASEW;

typedef struct {
    DWORD dwNextPhonemeNode;
    DWORD dwUpAlternatePhonemeNode;
    DWORD dwDownAlternatePhonemeNode;
    DWORD dwPreviousPhonemeNode;
    DWORD dwWordNode;
    QWORD qwStartTime;
    QWORD qwEndTime;
    DWORD dwPhonemeScore;
    WORD wVolume;
    WORD wPitch;
} SRRESPHONEMENODE;

typedef struct {
    DWORD dwNextWordNode;
    DWORD dwUpAlternateWordNode;
    DWORD dwDownAlternateWordNode;
    DWORD dwPreviousWordNode;
    DWORD dwPhonemeNode;
    QWORD qwStartTime;
    QWORD qwEndTime;
    QWORD qwSilenceDuration;
    DWORD dwWordScore;
    WORD wVolume;
    WORD wPitch;
    VOICEPARTOFSPEECH pos;
    DWORD dwCFGParse;
    DWORD dwCue;
} SRRESWORDNODE;

// Dragon-extended version (identical layout, different COM identity)
typedef struct {
    DWORD dwNextWordNode;
    DWORD dwUpAlternateWordNode;
    DWORD dwDownAlternateWordNode;
    DWORD dwPreviousWordNode;
    DWORD dwPhonemeNode;
    QWORD qwStartTime;
    QWORD qwEndTime;
    QWORD qwSilenceDuration;
    DWORD dwWordScore;
    WORD wVolume;
    WORD wPitch;
    VOICEPARTOFSPEECH pos;
    DWORD dwCFGParse;
    DWORD dwCue;
} DGNSRRESWORDNODE;

typedef struct {
    DWORD message;
    DWORD paramL;
    DWORD paramH;
} HOOK_EVENTMSG;

// DGN_ERROR_W — extended error info from IDgnErrorW::LastErrorGet
// dspeech.h: { int m_nCode; WCHAR m_szParms[300]; } = 604 bytes
typedef struct {
    int m_nCode;
    WCHAR m_szParms[300];
} DGN_ERROR_W;

typedef enum {
    CHARSET_TEXT = 0,
    CHARSET_IPAPHONETIC = 1,
    CHARSET_ENGINEPHONETIC = 2
} VOICECHARSET;

typedef enum {
    SAPI_POSTYPE = 1
} POSTYPE;

typedef struct {
    POSTYPE POS_Type;
    VOICEPARTOFSPEECH SAPI_POS;
    BYTE Dgn_POS[16];
} POSINFO;

typedef struct {
    DWORD dwAutoGainEnable;
    DWORD dwAwakeState;
    DWORD dwThreshold;
    DWORD dwDevice;
    DWORD dwEnable;
    CHAR szMicrophone[32];
    CHAR szSpeaker[32];
    GUID gModeID;
} VDSITEINFOA;

typedef struct {
    DWORD dwAutoGainEnable;
    DWORD dwAwakeState;
    DWORD dwThreshold;
    DWORD dwDevice;
    DWORD dwEnable;
    WCHAR szMicrophone[32];
    WCHAR szSpeaker[32];
    GUID gModeID;
} VDSITEINFOW;

typedef struct {
    CHAR szTopic[32];
    LANGUAGEA language;
} VDCTTOPICA;

typedef struct {
    WCHAR szTopic[32];
    LANGUAGEW language;
} VDCTTOPICW;

typedef struct {
    DWORD dwID;
    DWORD dwPosn;
} VDCTBOOKMARK;


// Forward declarations
interface IDgnSRWordEnumA;
interface IDgnSRWordEnumW;
interface IDgnSRWordPrefixEnumA;
interface IDgnSRWordPrefixEnumW;
interface IDgnSSvcActionNotifySink;


