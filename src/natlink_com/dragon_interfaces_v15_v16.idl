// Interface definitions
// ===================================================================

// -------------------------------------------------------------------
// IDgnErrorW
// Source: dspeech.h — extended error information from Dragon (Unicode)
// -------------------------------------------------------------------

[
    object,
    uuid(dd109005-6205-11cf-ae61-0000e8a28647),
    pointer_default(unique)
]
interface IDgnErrorW : IUnknown
{
    HRESULT LastErrorGet(
        [in, out, unique] DGN_ERROR_W* p0
    );

    HRESULT ErrorMessageGet(
        [in, out, unique, size_is(p1)] wchar_t* p0,  // output buffer
        [in] DWORD p1,                                // buffer capacity (wchar count)
        [in, out, unique] DWORD* p2                   // actual wchar count needed
    );
};

